[Unit]
Description=Тик прогонов olleval: раз в четверть часа проверить, не пора ли

[Timer]
# Раз в 15 минут. Сам скрипт решает, его ли сейчас время: вне окна и при живом
# прогоне он выходит сразу. Такой тик заодно поднимает прогон, если тот умер
# посреди окна, — расписание при этом живёт в olleval.toml, а не в таймере.
OnCalendar=*-*-* *:00/15:00
Persistent=false
Unit=olleval-night.service

[Install]
WantedBy=timers.target
