# Внутренние заметки: наружу не уезжают.
# В них остаются настоящие адреса стенда, имена машин и учётных записей.
/docs/
/.claude/
/CLAUDE.md

# Собранные бинари и архивы выпуска
/ollchat
/olldiagtools/olldiagtools
/dist/

# Рабочие файлы: книги и документы для проб, чужие материалы
/tmp/

# Резервные копии настроек
*.bak
*.bak-*
*.bak[0-9]-*
config.toml.bak*

# Каталоги сред разработки
.idea/
.vscode/
*.swp

# Измерительный инструмент ночных прогонов: задачи с эталонами и фикстуры
# с заложенными дефектами. Публикация их убивает: попав в открытый доступ,
# они попадут и в обучающие выборки — модель начнёт «решать» их по памяти.
/olleval/suites/
/olleval/fixtures/
/olleval/olleval
